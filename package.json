    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lenis": "^1.3.27",
    "postprocessing": "^6.39.5",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
