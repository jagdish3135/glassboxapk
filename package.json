{
  "name": "glassboxapk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "view": "node scripts/run.mjs scripts/view.ts",
    "decompile": "node scripts/run.mjs scripts/decompile.ts",
    "scan": "node scripts/run.mjs scripts/scan-apk.ts",
    "validate-report": "node scripts/run.mjs scripts/validate-report.ts",
    "sample-report": "node scripts/run.mjs scripts/sample-report.ts",
    "build": "tsc -b && vite build",
    "serve": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/run.mjs scripts/fixture.test.ts && node scripts/run.mjs scripts/report.test.ts",
    "test:e2e": "node scripts/run.mjs scripts/landing.e2e.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^9.122.0",
